NODE_ENV=development

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=payment_db

# Blockchain
# NETWORK_PROFILE: local (default) | testnet | mainnet. Sets confirmations,
# confirmation timeout and fee caps; see src/config/network.config.ts and
# .env.mainnet.example.
NETWORK_PROFILE=local
BLOCKCHAIN_RPC_URL=http://localhost:8545
# Leave empty to run without a contract (off-chain bookkeeping only).
ESCROW_HUB_ADDRESS=
# First anvil dev key. Never use it anywhere but a local chain.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Batch settlement scheduler (off unless enabled)
SETTLEMENT_BATCH_ENABLED=false
SETTLEMENT_BATCH_WINDOW_MS=60000
SETTLEMENT_BATCH_MAX_RECEIPTS=100
SETTLEMENT_BATCH_TICK_MS=5000

# Settlement retry queue
SETTLEMENT_RETRY_ENABLED=true
SETTLEMENT_RETRY_MAX_ATTEMPTS=5
SETTLEMENT_RETRY_BASE_DELAY_MS=30000
SETTLEMENT_RETRY_MAX_DELAY_MS=3600000

# Protocol fees: default rate in basis points, optional bounds, per-chain overrides
CHAIN_ID=31337
FEE_DEFAULT_BPS=50
FEE_DEFAULT_MIN=0
FEE_DEFAULT_MAX=
# FEE_POLICIES={"71234":{"bps":30,"minFee":"0.0001","maxFee":"5"}}

# Spending limits: max total deposit per payer per rolling window (empty or 0 = unlimited)
SPENDING_LIMIT_DAILY_DEFAULT=
SPENDING_LIMIT_WINDOW_HOURS=24

# Escrow expiry sweep: expire sessions past their TTL and refund them (off unless enabled)
ESCROW_EXPIRY_SWEEP_ENABLED=false
ESCROW_EXPIRY_SWEEP_MS=60000

# Reconciliation of the ledger with EscrowHub (0 = periodic job off)
RECONCILIATION_INTERVAL_MS=0
RECONCILIATION_BATCH_SIZE=200

# Webhooks: per-attempt timeout; plain http is refused when NODE_ENV=production
WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_ALLOW_HTTP=false
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_RETRY_BASE_DELAY_MS=10000
WEBHOOK_RETRY_MAX_DELAY_MS=3600000

# Idempotency keys: how long a stored response is replayed
IDEMPOTENCY_TTL_SECONDS=86400

# Emergency pause from the environment: all | settlement | streaming (comma-separated).
# Normally empty; the switch is operated through POST /admin/pause.
EMERGENCY_PAUSE=

# API
PORT=3003
CORS_ORIGINS=http://localhost:3000

# Security
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100
HSTS_ENABLED=true
