{
  "title": "PROM Payment Rail",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["payment-rail", "prom"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"payment-rail\"}[5m])) by (method,route)",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"payment-rail\"}[5m])) by (le,route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"payment-rail\",status=~\"5..\"}[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
