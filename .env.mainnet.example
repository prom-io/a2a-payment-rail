# Mainnet profile for a2a-payment-rail.
#
# Copy to the secret store of the deployment, never to a file in the image or
# the repository. Every value marked <...> must be replaced; the placeholders
# are deliberately not usable.

NODE_ENV=production
NETWORK_PROFILE=mainnet

# --- Chain -------------------------------------------------------------------
# The profile sets: 12 confirmations, 10 min confirmation timeout,
# 50 gwei max fee, 2 gwei max priority fee. Override only with a reason.
CHAIN_ID=<mainnet chain id>
BLOCKCHAIN_RPC_URL=https://<mainnet rpc endpoint>
BLOCKCHAIN_PRIVATE_KEY=<settlement signer key, from the secret store>
ESCROW_HUB_ADDRESS=<EscrowHub address on mainnet>
# TX_CONFIRMATIONS=12
# TX_CONFIRMATION_TIMEOUT_MS=600000
# MAX_FEE_PER_GAS_GWEI=50
# MAX_PRIORITY_FEE_PER_GAS_GWEI=2

# --- Database ----------------------------------------------------------------
DATABASE_HOST=<postgres host>
DATABASE_PORT=5432
DATABASE_USER=<service role, not postgres>
DATABASE_PASSWORD=<from the secret store>
DATABASE_NAME=payment_db

# --- API and security --------------------------------------------------------
PORT=3003
CORS_ORIGINS=https://<console origin>
JWT_SECRET=<at least 32 random bytes>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CSRF_SECRET=<at least 32 random bytes>
HSTS_ENABLED=true

# --- Fees --------------------------------------------------------------------
# Keep bps equal to EscrowHub.feePercent on mainnet.
FEE_DEFAULT_BPS=50

# --- Jobs --------------------------------------------------------------------
# Start with the automatic jobs that send transactions switched off; enable
# them one at a time (see the launch checklist).
SETTLEMENT_BATCH_ENABLED=false
ESCROW_EXPIRY_SWEEP_ENABLED=false
SETTLEMENT_RETRY_ENABLED=true
SETTLEMENT_RETRY_MAX_ATTEMPTS=5
RECONCILIATION_INTERVAL_MS=900000

# --- Limits ------------------------------------------------------------------
SPENDING_LIMIT_DAILY_DEFAULT=<per-payer daily cap in the native token>

# --- Webhooks ----------------------------------------------------------------
# https only in production; do not set WEBHOOK_ALLOW_HTTP.
WEBHOOK_TIMEOUT_MS=5000
